{
  "name": "simple-vscode-ai-tool-autocomplete",
  "displayName": "simple vscode ai tool autocomplete",
  "publisher": "avel2k6",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simple-vscode-ai-tool-autocomplete.helloWorld",
        "title": "Hello World"
      }
    ],
    "keybindings": [
      {
        "command": "simple-vscode-ai-tool-autocomplete.helloWorld",
        "key": "alt+/",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "AI Autocomplete",
      "properties": {
        "simple-vscode-ai-tool-autocomplete.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Базовый URL OpenAI-совместимого API"
        },
        "simple-vscode-ai-tool-autocomplete.model": {
          "type": "string",
          "default": "",
          "description": "Название модели"
        },
        "simple-vscode-ai-tool-autocomplete.apiKey": {
          "type": "string",
          "default": "",
          "description": "API-ключ (Bearer). Пусто — без авторизации"
        },
        "simple-vscode-ai-tool-autocomplete.temperature": {
          "type": "number",
          "default": 0.2,
          "description": "Temperature генерации"
        },
        "simple-vscode-ai-tool-autocomplete.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Таймаут запроса, мс"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint .",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
